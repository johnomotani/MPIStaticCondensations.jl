#!/bin/bash

# Slurm job options (job-name, compute nodes, job time)
#SBATCH --job-name=benchmark
#SBATCH --time=12:0:0
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=256
#SBATCH --cpus-per-task=1

#SBATCH --account=<account_name>
#SBATCH --partition=dcgp_fua_prod
#SBATCH --qos=normal

# Set the number of threads to 1
#   This prevents any threaded system libraries from automatically
#   using threading.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

source julia.env

export MPITRAMPOLINE_MPIEXEC=$PWD/mpiwrapper/bin/mpiwrapper-mpiexec
export MPITRAMPOLINE_LIB=$PWD/mpiwrapper/lib64/libmpiwrapper.so

#JSO="-J mpistaticcondensations.so"

np=256
PROC_PER_CACHE=$(( ($np + 15) / 16 ))
echo np=$np PROC_PER_CACHE=$PROC_PER_CACHE
echo MPIStaticCondensations
mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-multivariable-MPIStaticCondensations.jl
echo MUMPS
mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-multivariable-MUMPS.jl

for np in 128 64 32 16 8 4 2 1; do
  PROC_PER_CACHE=$(( ($np + 15) / 16 ))
  echo np=$np PROC_PER_CACHE=$PROC_PER_CACHE
  echo MPIStaticCondensations
  mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-multivariable-MPIStaticCondensations.jl
  echo MUMPS
  mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-multivariable-MUMPS.jl
done
