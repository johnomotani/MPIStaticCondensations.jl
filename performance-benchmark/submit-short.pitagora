#  PROC_PER_CACHE=$(( ($np + 15) / 16 ))
#  mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-MPIStaticCondensations.jl
#  mpirun -np $np --map-by ppr:$PROC_PER_CACHE:L3cache --bind-to core ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl
#  nt=2; OMP_NUM_THREADS=$nt OPENBLAS_NUM_THREADS=$nt OMP_PLACES=cores mpirun -np $np --bind-to none ./julia $JSO --project -O3 -t$nt benchmark-MUMPS.jl
#done

np=1
mpirun -np $np ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl
