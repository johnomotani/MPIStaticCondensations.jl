#!/bin/bash

# Slurm job options (job-name, compute nodes, job time)
#SBATCH --job-name=benchmark
#SBATCH --time=0:20:0
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1

#SBATCH --account=<account_name>
#SBATCH --partition=standard
#SBATCH --qos=short

# Set the number of threads to 1
#   This prevents any threaded system libraries from automatically
#   using threading.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# Propagate the cpus-per-task setting from script to srun commands
#    By default, Slurm does not propagate this setting from the sbatch
#    options to srun commands in the job script. If this is not done,
#    process/thread pinning may be incorrect leading to poor performance
export SRUN_CPUS_PER_TASK=$SLURM_CPUS_PER_TASK

# Launch the parallel job
#   Using 128 MPI processes and 128 MPI processes per node
#   srun picks up the distribution from the sbatch options

source julia.env

export MPITRAMPOLINE_MPIEXEC=$PWD/mpiwrapper/bin/mpiwrapper-mpiexec
export MPITRAMPOLINE_LIB=$PWD/mpiwrapper/lib64/libmpiwrapper.so

#JSO="-J mpistaticcondensations.so"

#np=128
#srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MPIStaticCondensations.jl
#srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl

#for np in 64 32 16 8 4 2 1; do
#  srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MPIStaticCondensations.jl
#  srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl
#  nt=2; OMP_NUM_THREADS=$nt OPENBLAS_NUM_THREADS=$nt OMP_PLACES=cores srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t2 benchmark-MUMPS.jl
#done

./julia --project -O3 -t1 -e "using Pkg; Pkg.precompile()"
OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 ./julia --project -O3 -t1

np=1
#srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl
srun --ntasks=$np --distribution=block:block --hint=nomultithread ./julia $JSO --project -O3 -t1 benchmark-MUMPS.jl
